---
import {
  FULL_DECIMAL_PLACES,
  getDecimalYearSnapshot,
} from "../lib/decimal-year.mjs";

// 静态 HTML 先提供构建时的真实值，JavaScript 加载前也不会出现空白或从零跳变。
const initialSnapshot = getDecimalYearSnapshot(new Date(), FULL_DECIMAL_PLACES);
---

<p class="decimal-year" data-decimal-year tabindex="0">
  <span class="decimal-year-label" data-decimal-year-label>{initialSnapshot.label}</span>
  <span class="decimal-year-prefix" aria-hidden="true">YEAR / </span>
  <span class="decimal-year-values" aria-hidden="true">
    <span class="decimal-year-value decimal-year-progress" data-decimal-year-value>{initialSnapshot.value}</span>
    <span class="decimal-year-value decimal-year-timeline" data-decimal-year-timeline>
      <span class="decimal-year-endpoint" data-decimal-year-current>{initialSnapshot.currentYear}</span>
      <span class="decimal-year-meter">
        <span class="decimal-year-percentage" data-decimal-year-percentage>{initialSnapshot.progressPercentage}</span>
        <svg
          class="decimal-year-meter-track"
          viewBox="0 0 100 6"
          preserveAspectRatio="none"
          focusable="false"
        >
          <line class="decimal-year-meter-base" x1="0" y1="4" x2="100" y2="4"></line>
          <line
            class="decimal-year-meter-fill"
            data-decimal-year-meter-fill
            x1="0"
            y1="4"
            x2={initialSnapshot.progressPosition}
            y2="4"
          ></line>
          <line
            class="decimal-year-meter-marker"
            data-decimal-year-meter-marker
            x1={initialSnapshot.progressPosition}
            y1="1"
            x2={initialSnapshot.progressPosition}
            y2="6"
          ></line>
        </svg>
      </span>
      <span class="decimal-year-endpoint decimal-year-endpoint-next" data-decimal-year-next>{initialSnapshot.nextYear}</span>
    </span>
  </span>
</p>

<script>
  import {
    createDecimalYearTicker,
    getDecimalYearSnapshot,
  } from "../lib/decimal-year.mjs";

  const counter = document.querySelector<HTMLElement>("[data-decimal-year]");
  const value = counter?.querySelector<HTMLElement>("[data-decimal-year-value]");
  const currentYear = counter?.querySelector<HTMLElement>("[data-decimal-year-current]");
  const percentage = counter?.querySelector<HTMLElement>("[data-decimal-year-percentage]");
  const nextYear = counter?.querySelector<HTMLElement>("[data-decimal-year-next]");
  const meterFill = counter?.querySelector<SVGLineElement>("[data-decimal-year-meter-fill]");
  const meterMarker = counter?.querySelector<SVGLineElement>("[data-decimal-year-meter-marker]");
  const label = counter?.querySelector<HTMLElement>("[data-decimal-year-label]");

  if (
    counter &&
    value &&
    currentYear &&
    percentage &&
    nextYear &&
    meterFill &&
    meterMarker &&
    label
  ) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    /** 按指定层生成一次快照；同一层的年份、百分比和轨道始终成组更新。 */
    const renderCounter = ({
      value: renderValue,
      progress: renderProgress,
    }: {
      value: boolean;
      progress: boolean;
    }) => {
      const snapshot = getDecimalYearSnapshot(new Date());

      if (renderValue) value.textContent = snapshot.value;

      if (renderProgress) {
        currentYear.textContent = snapshot.currentYear;
        percentage.textContent = snapshot.progressPercentage;
        nextYear.textContent = snapshot.nextYear;
        meterFill.setAttribute("x2", snapshot.progressPosition);
        meterMarker.setAttribute("x1", snapshot.progressPosition);
        meterMarker.setAttribute("x2", snapshot.progressPosition);

        // 文案实际变化时才改写无障碍树，避免持续刷新干扰读屏器。
        if (label.textContent !== snapshot.label) label.textContent = snapshot.label;
      }
    };

    // 默认态保持 20ms，悬浮百分比与轨道独立保持 100ms。
    const ticker = createDecimalYearTicker({
      render: renderCounter,
      schedule: (callback, intervalMs) => window.setInterval(callback, intervalMs),
      cancel: (timerId) => window.clearInterval(timerId as number),
    });

    /** 将浏览器当前状态同步给计时器。 */
    const syncCounter = () => {
      ticker.sync({ hidden: document.hidden, reducedMotion: reducedMotion.matches });
    };

    reducedMotion.addEventListener("change", syncCounter);
    document.addEventListener("visibilitychange", syncCounter);
    window.addEventListener("pagehide", ticker.stop);
    window.addEventListener("pageshow", (event) => {
      // 从浏览器往返缓存恢复时重新启动两种节奏；首次加载不重复创建计时器。
      if (event.persisted) syncCounter();
    });
    counter.addEventListener("pointerenter", () => {
      renderCounter({ value: false, progress: true });
    });
    counter.addEventListener("focus", () => {
      renderCounter({ value: false, progress: true });
    });
    syncCounter();
  }
</script>
